# Local PostgreSQL or Supabase transaction-pooler connection string.
# Replace the placeholder credentials before starting the API.
DATABASE_URL=postgres://ekapon_api:CHANGE_ME@127.0.0.1:5432/ekapon

# Generate a unique secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

NODE_ENV=development
SESSION_HOURS=8
LOGIN_IP_MAX_FAILURES=20
ALLOWED_ORIGINS=
