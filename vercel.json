{
 "rewrites": [
  {
   "source": "/api/v1/:path*",
   "destination": "/api?route=/api/v1/:path*"
  }
 ],
 "headers": [
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/manifest.webmanifest",
   "headers": [
    {
     "key": "Content-Type",
     "value": "application/manifest+json"
    }
   ]
  }
 ]
}